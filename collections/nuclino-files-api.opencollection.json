{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nuclino Collections Files API",
    "version": "v0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nuclino.com/v0/files/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "UUID of the file"
              }
            ]
          },
          "docs": "Returns metadata and a temporary download URL for a file attachment."
        }
      ]
    }
  ],
  "bundled": true
}